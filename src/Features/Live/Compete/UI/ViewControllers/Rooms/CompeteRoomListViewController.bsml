<bg horizontal-fit="PreferredSize" vertical-fit="PreferredSize" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd">
  <vertical horizontal-fit="PreferredSize" vertical-fit="PreferredSize" spacing="2">
    <horizontal bg="panel-top" horizontal-fit="PreferredSize" pref-width="82">
      <text text="~room-list-title" align="Center" font-size="6.5" overflow-mode="Ellipsis" />
    </horizontal>

    <horizontal horizontal-fit="PreferredSize" vertical-fit="PreferredSize" pref-width="82" spacing="2">
      <text text="~room-list-subtitle" align="Center" font-size="2.8" pref-width="56" pref-height="9" word-wrapping="true" />
      <button text="Refresh" on-click="refresh-rooms" pref-width="22" pref-height="8" interactable="~can-refresh" />
    </horizontal>

    <vertical pref-width="82" pref-height="52" pad-left="0" pad-right="2" pad-top="2" pad-bottom="2">
      <custom-list active="~rooms-active" id="room-list" list-width="80" visible-cells="4" cell-size="12" contents="rooms" select-cell="room-selected" show-scrollbar="true">
        <stack pref-width="80" pref-height="12" min-width="80">
          <vertical horizontal-fit="PreferredSize" vertical-fit="PreferredSize" child-control-width="true" child-expand-width="false" pref-width="80" pref-height="12" min-width="80" spacing="0">
            <horizontal horizontal-fit="PreferredSize" vertical-fit="PreferredSize" child-control-width="true" child-expand-width="false" pref-width="80" pref-height="10.8" min-width="80" spacing="2">
              <vertical pref-width="57" pref-height="10.2" min-width="57" spacing="0" child-align="MiddleLeft">
                <text text="~row-title" align="Left" font-size="3.4" pref-width="57" min-width="57" pref-height="5" overflow-mode="Ellipsis" />
                <text text="~row-detail" align="Left" font-size="2.45" pref-width="57" min-width="57" pref-height="4" overflow-mode="Ellipsis" />
              </vertical>
              <vertical pref-width="21" pref-height="10" min-width="21" child-align="MiddleRight">
                <text text="~row-status" align="Right" font-size="2.8" pref-width="21" min-width="21" pref-height="4.5" overflow-mode="Ellipsis" />
              </vertical>
            </horizontal>
            <image id="row-separator" src="#WhitePixel" image-color="#FFFFFF22" pref-width="80" min-width="80" pref-height="0.35" />
          </vertical>
        </stack>
      </custom-list>

      <vertical active="~rooms-refreshing" pref-width="68" pref-height="38" child-align="MiddleCenter">
        <text text="Refreshing rooms..." align="Center" font-size="4" word-wrapping="true" />
      </vertical>

      <vertical active="~rooms-empty" pref-width="68" pref-height="38" child-align="MiddleCenter">
        <text text="No rooms are available for you yet. Ask an organiser to add you when a match is ready." align="Center" font-size="4" word-wrapping="true" />
      </vertical>
    </vertical>
  </vertical>
</bg>
