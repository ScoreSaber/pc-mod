<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
	<tab-selector tab-tag='tabs'/>
	<horizontal preferred-width='100' preferred-height='58' pad-top='8'>
		<tab tab-name='Leaderboard' tags='tabs'>
			<modifier-container child-expand-width='true' horizontal-fit='PreferredSize'>
				<toggle-setting text='Show Score PP' id='showScorePPSetting' value='showScorePP' bind-value='true' apply-on-change='true' />
				<toggle-setting text='Show Local Player Rank' id='showLocalPlayerRankSetting' value='showLocalPlayerRank' bind-value='true' apply-on-change='true' />
				<toggle-setting text='Hide NA Scores' id='hideNAScoresSetting' value='hideNAScores' bind-value='true' apply-on-change='true' />
				<toggle-setting text='Country/Region Around You' id='enableCountryLeaderboardsSetting' value='enableCountryLeaderboards' bind-value='true' apply-on-change='true' />
				<dropdown-list-setting preferred-width='30' text="Location Filter" options="locationFilterOptions" value="locationFilterMode" bind-value='true' apply-on-change='true'/>
			</modifier-container>
		</tab>
		<tab tab-name='Live' tags='tabs'>
			<modifier-container child-expand-width='true' horizontal-fit='PreferredSize'>
				<toggle-setting text='Public Live Presence' id='publicLivePresenceSetting' value='publicLivePresenceEnabled' bind-value='true' apply-on-change='true' hover-hint='Publish your public live presence.' />
				<toggle-setting text='Spectator Chat Overlay' id='liveChatOverlaySetting' value='liveChatOverlayEnabled' bind-value='true' apply-on-change='true' hover-hint='Show spectator chat after messages arrive.' />
				<toggle-setting text='Spectator Chat In Gameplay' id='liveChatOverlayGameplaySetting' value='liveChatOverlayGameplayEnabled' bind-value='true' apply-on-change='true' hover-hint='Show spectator chat while playing after messages arrive.' />
				<toggle-setting text='Share HSV Profile' id='shareLiveHsvProfilesSetting' value='shareHsvProfiles' bind-value='true' apply-on-change='true' hover-hint='Include your selected HitScoreVisualizer profile when streaming live replays.' />
				<slider-setting preferred-width='70' size-delta-x='70' show-buttons='true' increment='0.05' min='0.85' max='1.75' text='Chat Window Scale' value='liveChatOverlayScale' bind-value='true' apply-on-change='true' hover-hint='Resize the floating spectator chat window.' />
				<slider-setting preferred-width='70' size-delta-x='70' show-buttons='true' increment='0.05' min='0.9' max='1.8' text='Chat Text Scale' value='liveChatOverlayTextScale' bind-value='true' apply-on-change='true' hover-hint='Resize the floating spectator chat text.' />
			</modifier-container>
		</tab>
		<tab tab-name='Replays' tags='tabs'>
			<vertical>
				<modifier-container child-expand-width='true' horizontal-fit='PreferredSize'>
					<toggle-setting  text='Save Local Replays' id='saveLocalReplaysSetting' value='saveLocalReplays' apply-on-change='true' />
					<toggle-setting  text='Camera smoothing' id='replayCameraSmoothingSetting' value='replayCameraSmoothing' apply-on-change='true' />
					<toggle-setting  text='Override handedness' id='replayOverrideHandednessSetting' value='replayOverrideHandedness' apply-on-change='true' hover-hint='This might break replays with modded requirements!'/>
					<toggle-setting  text='Use Recorded Player Settings' id='useRecordedPlayerSettingsSetting' value='useRecordedPlayerSettings' apply-on-change='true' hover-hint='Use recorded colors, jump distance, environment, lights, and arc preferences when available.' />
					<toggle-setting  text='Share HSV Profile' id='shareReplayHsvProfilesSetting' value='shareHsvProfiles' bind-value='true' apply-on-change='true' hover-hint='Include your selected HitScoreVisualizer profile in replay files and live streams.' />
					<slider-setting  show-buttons='true' increment='0.1' min='60' max='120' text='Camera FOV' value='replayCameraFOV' apply-on-change='true' hover-hint='This only applies to the base game camera!' />
				</modifier-container>
				<modifier-container child-expand-width='true' horizontal-fit='PreferredSize'>
					<horizontal spacing='2'>
						<slider-setting preferred-width='65' size-delta-x='65' show-buttons='true' increment='0.1' min='-180' max='180'  text='X Rot' value='currentXValueRotation' bind-value='true' apply-on-change='true' />
						<slider-setting preferred-width='65' size-delta-x='65' show-buttons='true' increment='0.01' min='-10' max='10'  text='X Offset' value='currentXValueOffset' bind-value='true' apply-on-change='true' />
					</horizontal>
					<horizontal spacing='2'>
						<slider-setting preferred-width='65' size-delta-x='65' show-buttons='true' increment='0.1' min='-180' max='180'  text='Y Rot' value='currentYValueRotation' bind-value='true' apply-on-change='true' />
						<slider-setting preferred-width='65' size-delta-x='65' show-buttons='true' increment='0.01' min='-10' max='10'  text='Y Offset' value='currentYValueOffset' bind-value='true' apply-on-change='true' />
					</horizontal>
					<horizontal spacing='2'>
						<slider-setting preferred-width='65' size-delta-x='65' show-buttons='true' increment='0.1' min='-180' max='180'  text='Z Rot' value='currentZValueRotation' bind-value='true' apply-on-change='true' />
						<slider-setting preferred-width='65' size-delta-x='65' show-buttons='true' increment='0.01' min='-10' max='10'  text='Z Offset' value='currentZValueOffset' bind-value='true' apply-on-change='true' />
					</horizontal>
				</modifier-container>
			</vertical>
		</tab>
	</horizontal>
</bg>
